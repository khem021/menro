.env
.env.*
.git
.github
.gitignore
node_modules
vendor
tests
docs
*.md
*.docx
*.py
deploy.sh

# Thesis diagrams at the repo root. Scoped to the root on purpose: public/images
# holds the logos the login page renders.
/MENRO-*.png

# Built in stage 1 of the Dockerfile, never copied from the host.
public/build
public/hot

# On Windows this may be a junction or a real directory, and
# `storage:link --force` only replaces symlinks — shipping it breaks the link.
public/storage

storage/app/public/*
storage/app/archives/*
storage/app/livewire-tmp/*
storage/logs/*
storage/framework/cache/*
storage/framework/sessions/*
storage/framework/views/*
